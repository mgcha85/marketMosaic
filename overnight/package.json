{
  "name": "overnight-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=dev vite",
    "dev:container": "APP_ENV=dev vite --host 0.0.0.0 --port 1420",
    "build": "APP_ENV=prod vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "podman:up": "podman compose -f podman-compose.yaml up -d --build",
    "podman:down": "podman compose -f podman-compose.yaml down",
    "podman:logs": "podman compose -f podman-compose.yaml logs -f overnight-app",
    "e2e": "playwright test",
    "e2e:container": "E2E_BASE_URL=http://127.0.0.1:1420 playwright test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lightweight-charts": "^5.1.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.5.14",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
