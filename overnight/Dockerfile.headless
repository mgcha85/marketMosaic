FROM rust:1.89-bookworm

ARG NODE_MAJOR=20

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl pkg-config libssl-dev build-essential \
  && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && npm i -g npm@latest \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/overnight

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 1420

CMD ["npm", "run", "dev:container"]
